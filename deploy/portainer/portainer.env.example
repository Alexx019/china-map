# Introducir estos valores en Environment variables del stack, en Portainer.
BASIC_USER=viaje
# Pegar el hash bcrypt completo generado con caddy hash-password.
# En el formulario de Portainer no duplicar los signos $ ni añadir comillas.
BASIC_HASH=REEMPLAZAR_POR_HASH_BCRYPT
WEB_PORT=9012
WEB_BIND_IP=0.0.0.0
# Opcional: AAAAMMDD. Vacío = último build disponible durante la primera extracción.
MAP_BUILD=
