# Introducir estos valores en Environment variables del stack, en Portainer.
WEB_PORT=9012
WEB_BIND_IP=0.0.0.0
# Opcional: AAAAMMDD. Vacío = último build disponible durante la primera extracción.
MAP_BUILD=
# MCP remoto: vacío = desactivado. Generar el hash con npm --prefix server run password.
MCP_PUBLIC_URL=https://china.ariassouto.es
MCP_PASSWORD_HASH=
MCP_ALLOWED_ORIGINS=
