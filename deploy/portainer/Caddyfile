:80 {
	encode zstd gzip

	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	@fresh path /sw.js /index.html / /manifest.webmanifest /data/places.json /data/thumbs/photos.json
	header @fresh Cache-Control "no-cache"
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy api:8787
	}

	# Fuera de la imagen: no oculta los glifos incluidos en /srv/site/map/fonts.
	# Un mapa ausente devuelve 404, nunca index.html. file_server soporta Range.
	handle /map/trip.pmtiles {
		root * /maps
		rewrite * /trip.pmtiles
		file_server
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}
}
