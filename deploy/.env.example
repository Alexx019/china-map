# Copiar como .env en la carpeta de despliegue de la Raspberry (NO se sube al repo).
# Dominio que apunta a casa de Alex (DNS o DDNS), con los puertos 80 y 443 abiertos hacia la Pi.
DOMAIN=china-map.ejemplo.com
# Usuario y contraseña de la web. El hash se genera con:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'la-contraseña'
BASIC_USER=viaje
BASIC_HASH=$2a$14$...
