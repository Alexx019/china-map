# china-map en la Raspberry. Variables en deploy/.env de la Pi (ver deploy/README.md).
{$DOMAIN} {
	encode zstd gzip

	# Contraseña para toda la web (la PWA pide el manifest con credenciales)
	basic_auth {
		{$BASIC_USER} {$BASIC_HASH}
	}

	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		# Todo se sirve desde la Pi: nada de terceros. Estilos en línea: React; blob: el worker de MapLibre
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Lo que tiene que comprobarse siempre (versión nueva de la app o datos nuevos)
	@fresh path /sw.js /index.html / /manifest.webmanifest /data/places.json /data/thumbs/photos.json
	header @fresh Cache-Control "no-cache"

	# Ficheros con hash en el nombre: no cambian nunca
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Estados y rutas compartidos
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy api:8787
	}

	root * /srv/site
	try_files {path} /index.html
	file_server
}
